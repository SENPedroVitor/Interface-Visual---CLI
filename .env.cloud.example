# Exemplo de configuração para o primeiro deploy cloud.
# Copie os valores para o secret manager do provedor; não commite credenciais.

# --- Supabase (backend/worker) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
# Somente no backend. Nunca exponha esta chave ao frontend.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
# Postgres usado quando a persistência cloud estiver habilitada.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require

# --- API pública ---
WADDLE_CORS_ORIGINS=https://<frontend-domain>
WADDLE_WS_PUBLIC_URL=wss://<api-domain>
# Segurança: somente estes usuários podem acessar o runtime cloud.
WADDLE_AUTH_MODE=supabase
WADDLE_ALLOWED_EMAILS=you@example.com

# --- Frontend Vite (valores públicos) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
VITE_API_URL=https://<api-domain>
VITE_WS_URL=wss://<api-domain>

# --- Provedor de IA do worker cloud (opcional) ---
# Use o secret manager. Não use chaves em variáveis VITE_*.
OPENAI_API_KEY=<openai-api-key>
ANTHROPIC_API_KEY=<anthropic-api-key>

# --- Bridge local opcional ---
# O bridge usa estes valores localmente; o cloud não recebe o token em texto.
WADDLE_BRIDGE_URL=http://127.0.0.1:<bridge-port>
WADDLE_BRIDGE_TOKEN=<rotated-bridge-token>
