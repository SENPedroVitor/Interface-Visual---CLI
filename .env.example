# Example .env for Waddle
# Copy to .env and adjust as needed.

# Workspace (vault) used by codex/qwen during sessions.
# Default when unset: ~/Documents/vault-faux
OBSIDIAN_VAULT_PATH=

# Custom CLI commands/flags (optional; defaults to "codex" / "qwen" in PATH).
CODEX_CMD=
QWEN_CMD=

# LLM providers used by Waddle's in-app agent discussions.
# Ollama is local by default. Run: ollama serve && ollama pull qwen2.5:0.5b
OLLAMA_HOST=http://127.0.0.1:11434

# Temporarily route Quinta and every Waddle agent through one provider.
# Leave blank to keep each agent's individual provider configuration.
WADDLE_AGENT_PROVIDER=codex
# Use the locally authenticated Codex CLI instead of the OpenAI HTTP API.
WADDLE_CODEX_TRANSPORT=cli

# Computer access mode for the local Codex terminal bridge.
# workspace (default): project workspace only; full: whole Windows drive with
# Codex's danger-full-access sandbox. Screen sharing remains a separate,
# user-visible permission and is never enabled by this flag.
WADDLE_COMPUTER_ACCESS=workspace
# Optional explicit root. In full mode, leaving this blank uses the system drive.
WADDLE_TERMINAL_WORKSPACE=

# Optional cloud providers. Leave blank to keep safe fallback responses.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01

# Display name shown in the UI (optional).
OSAURUS_NAME=

# Optional persistent data root. On Windows this can point to another drive,
# for example: WADDLE_DATA_DIR=D:\\banco de dados waddle
WADDLE_DATA_DIR=

# Integrações públicas sem chave:
# Livro consulta TheSportsDB; Ma consulta Yahoo Finance Chart.
# Mosbey grava filmes no serviço local do Faux Catálogo.
FAUX_CATALOGO_URL=http://127.0.0.1:4173

# Timeout for waiting on a CLI response, in milliseconds (optional).
WADDLE_RESPONSE_TIMEOUT_MS=60000

# WADDLE_LAST_BACKEND is managed automatically by the app; no need to set it here.
